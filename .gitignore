# This repo is split into backend/ (Go) and frontend/ (Next.js), each
# with its own .gitignore for language-specific patterns. This file
# only covers things that can show up anywhere in the tree.

# IDE
.idea/
.vscode/
*.swp
*.swo
.claude/

# OS
.DS_Store

# Environment / local secrets
.env
.env.*
!.env.example
