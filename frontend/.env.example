# Base URL of the Go rate limiter API this playground talks to.
# The API must allow this frontend's origin via CORS_ALLOWED_ORIGIN
# on the server (see ../README.md's Configuration section) — it
# defaults to http://localhost:3000, matching `next dev`'s default port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Base URL of the Prometheus instance scraping the API's /metrics
# endpoint (see ../backend/prometheus.yml). The Observability
# Dashboard queries this directly from the browser — Prometheus's
# default CORS policy (Access-Control-Allow-Origin: *) allows this
# without any server-side changes.
NEXT_PUBLIC_PROMETHEUS_BASE_URL=http://localhost:9090
